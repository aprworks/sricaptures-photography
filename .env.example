# Canonical site URL (no trailing slash). Used for sitemap, canonical URLs, Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# --- Contact form delivery -------------------------------------------------
# One of: formsubmit | resend | formspree | log   (default: formsubmit — no key needed)
# log = print to the server console only (development)
CONTACT_PROVIDER=formsubmit

# Where enquiries are delivered
CONTACT_TO_EMAIL=sricapturesphotography111@gmail.com

# Resend (https://resend.com) — optional alternative
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Studio Inquiries <inquiries@your-verified-domain.com>"

# Formspree (https://formspree.io) — full endpoint URL
FORMSPREE_ENDPOINT=

# --- Spam protection (optional, recommended in production) -----------------
# Cloudflare Turnstile: https://developers.cloudflare.com/turnstile/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics (optional: set ONE) -----------------------------------------
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
